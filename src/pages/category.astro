---
import StoreLayout from '../layouts/StoreLayout.astro';
---
<StoreLayout
  title="Koleksiyon — Özerler Kuyumculuk"
  description="Özerler Kuyumculuk koleksiyonu."
>
  <div class="topbar">
    <a href="/home">Ana Sayfa</a><span class="sep">/</span><span class="current" id="breadcrumbCurrent">…</span>
  </div>

  <div class="section">
    <div class="sec-head">
      <div class="eyebrow">Koleksiyon</div>
      <h2 id="categoryTitle">…</h2>
    </div>
    <div class="grid" id="category-grid">
      <p style="color:var(--ink-dim); grid-column:1/-1; text-align:center;">Yükleniyor...</p>
    </div>
  </div>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/PapaParse/5.4.1/papaparse.min.js" is:inline></script>
  <script src="/assets/js/products-data.js" is:inline></script>
  <script src="/assets/js/category.js" is:inline></script>
</StoreLayout>

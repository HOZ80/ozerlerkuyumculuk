---
import StoreLayout from '../layouts/StoreLayout.astro';
---
<StoreLayout
  title="Özerler Kuyumculuk — Ana Sayfa"
  description="Özerler Kuyumculuk — Altın, Gümüş ve Saat koleksiyonları. Kuşaklar boyu süren usta işçiliği, şimdi tüm Türkiye'ye açılıyor."
>
  <!-- HERO -->
  <section class="hero">
    <div class="hero-photo"></div>
    <div class="hero-copy">
      <div class="eyebrow">Zarafeti Tamamlayın</div>
      <h1 class="headline">Özenle Seçilmiş<br>Altın Takılar</h1>
      <p class="subhead">Kuşaklar boyu süren usta işçiliğiyle şekillenen koleksiyonumuz, şimdi tüm Türkiye'ye açılıyor.</p>
      <div class="cta-row">
        <a href="#koleksiyon" class="pill">Koleksiyona Gözat</a>
      </div>
    </div>
  </section>

  <!-- ÖNE ÇIKAN PARÇALAR -->
  <div class="section" id="koleksiyon">
    <div class="sec-head">
      <div class="eyebrow">Koleksiyon</div>
      <h2>Öne Çıkan Parçalar</h2>
    </div>
    <div class="grid" id="featured-grid">
      <p style="color:var(--ink-dim); grid-column:1/-1; text-align:center;">Yükleniyor...</p>
    </div>
  </div>

  <!-- KATEGORİ KUTULARI -->
  <section class="section" style="padding-top:0;">
    <div class="sec-head">
      <div class="eyebrow">Koleksiyonlar</div>
      <h2>Kategoriye Göre Keşfet</h2>
    </div>
    <div class="cat-boxes">
      <a class="cat-box" href="/category?cat=Alt%C4%B1n">
        <img src="/assets/img/categories/altin.jpg" alt="Altın Koleksiyonu">
        <div class="cat-box-label"><div class="cat-box-eyebrow">Koleksiyon</div><h3>Altın</h3></div>
      </a>
      <a class="cat-box" href="/category?cat=G%C3%BCm%C3%BC%C5%9F">
        <img src="/assets/img/categories/gumus.jpg" alt="Gümüş Koleksiyonu">
        <div class="cat-box-label"><div class="cat-box-eyebrow">Koleksiyon</div><h3>Gümüş</h3></div>
      </a>
      <a class="cat-box" href="/category?cat=Saat">
        <img src="/assets/img/categories/saat.jpg" alt="Saat Koleksiyonu">
        <div class="cat-box-label"><div class="cat-box-eyebrow">Koleksiyon</div><h3>Saat</h3></div>
      </a>
    </div>
  </section>

  <!-- KATEGORİ / VİTRİN ŞERİDİ -->
  <section class="section categories">
    <div class="sec-head">
      <div class="eyebrow">Vitrin</div>
      <h2>Neden Özerler</h2>
    </div>
    <div class="cat-grid">
      <div class="cat-card">
        <svg viewBox="0 0 60 60"><circle cx="30" cy="30" r="20"/><circle cx="30" cy="30" r="12"/></svg>
        <h3>Usta İşçiliği</h3>
        <p>Kırk yıllık zanaat mirasıyla şekillenen, el işçiliğine bağlı üretim.</p>
      </div>
      <div class="cat-card">
        <svg viewBox="0 0 60 60"><path d="M18 40 L30 14 L42 40 Z"/><path d="M22 33 L38 33"/></svg>
        <h3>Güvenilir Ayar</h3>
        <p>Her parça, belgeli ayar ve ağırlık garantisiyle sunulur.</p>
      </div>
      <div class="cat-card">
        <svg viewBox="0 0 60 60"><circle cx="30" cy="30" r="18"/><path d="M30 20 L30 30 L37 34"/></svg>
        <h3>Türkiye Geneli Kargo</h3>
        <p>Sigortalı kargo ile İstanbul'dan tüm Türkiye'ye güvenli teslimat.</p>
      </div>
    </div>
  </section>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/PapaParse/5.4.1/papaparse.min.js" is:inline></script>
  <script>
    import '../scripts/home.js';
  </script>
</StoreLayout>
